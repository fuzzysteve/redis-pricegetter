[Unit]
Description=pricegetter-redis: check Redis for stale price data and alert via Discord
After=pricegetter-loadprices.service

[Service]
Type=oneshot
WorkingDirectory=/opt/pricegetter-redis
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/pricegetter-redis/checkFreshness.sh
