[Unit]
Description=Run pricegetter-checkfreshness.service every 30 minutes, offset after loadprices. Not ESI-facing (Redis only), so it keeps running through loadprices' ESI-downtime skip.

[Timer]
OnCalendar=*-*-* *:16,46:00 UTC
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
