[Unit]
Description=pricegetter-redis: discover citadels with a public market
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pricegetter-redis
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/pricegetter-redis/structurePoller.sh
