[Unit]
Description=Run pricegetter-loadprices.service every 30 minutes, offset off :00/:30, skipping the ESI daily 11:00-11:30 UTC downtime window

[Timer]
OnCalendar=*-*-* 00..10:06,36:00 UTC
OnCalendar=*-*-* 11:36:00 UTC
OnCalendar=*-*-* 12..23:06,36:00 UTC
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
