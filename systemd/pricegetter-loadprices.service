[Unit]
Description=pricegetter-redis: fetch EVE market orders and publish aggregates to Redis
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pricegetter-redis
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/pricegetter-redis/loadPrices.sh
